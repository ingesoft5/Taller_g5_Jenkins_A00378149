// =============================================================================
// Taller Evaluativo 2 - Fase 4: Pipeline Declarativo en Jenkins
//
// Complete los TODOs de cada etapa. Recuerde:
//   - Prohibido el tag ":latest" al publicar en Nexus (empaquetamiento
//     inmutable, Fase 2).
//   - Las credenciales (usuario/clave de Nexus, token de GitHub) se
//     inyectan mediante los IDs configurados en Jenkins > Credentials,
//     NUNCA en texto plano dentro de este archivo.
// =============================================================================

pipeline {
    agent any

    environment {
        // TODO: defina el esquema de versionado inmutable combinando el
        // número de build de Jenkins y los primeros 7 caracteres del
        // commit actual. Pista: use "${env.BUILD_NUMBER}" y
        // "${env.GIT_COMMIT.take(7)}" dentro de un stage con "script {}"
        // (GIT_COMMIT solo está disponible después del checkout).
        
        IMAGE_TAG = "TODO-DEFINA-EN-UN-STAGE-SCRIPT"

        // TODO: ajuste host y puerto a los de su Nexus local (Fase 3).
        NEXUS_REGISTRY   = "TODO-HOST-REGISTRY:TODO-PUERTO-REGISTRY"
        NEXUS_MAVEN_REPO = "http://nexus:8081/repository/maven-releases/"

        // TODO: reemplace por el ID exacto de la credencial que usted
        // creó en Jenkins > Manage Jenkins > Credentials (Fase 3.e).
        NEXUS_CREDENTIALS_ID = "TODO-ID-CREDENCIAL-NEXUS"
    }

    stages {

            stage('Checkout & Test') {
            steps {
                checkout scm

                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                    echo "IMAGE_TAG = ${env.IMAGE_TAG}"
                }

                dir('backend') {
                    sh 'mvn -B test'
                }
            }
        }

        stage('Package & Tag Inmutable') {
            steps {
                dir('backend') {
                    sh 'mvn -B package -DskipTests'
                    sh "docker build -t ${NEXUS_REGISTRY}/studytrack-api:${IMAGE_TAG} ."
                }
                dir('frontend') {
                    sh """
                        docker build \
                        --build-arg VITE_API_URL=${VITE_API_URL} \
                        -t ${NEXUS_REGISTRY}/studytrack-frontend:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "${NEXUS_CREDENTIALS_ID}",
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {

                    // 1) JAR en maven-releases
                    dir('backend') {
                        sh '''
                            cat > settings-ci.xml <<EOF
        <settings>
        <servers>
            <server>
            <id>nexus-releases</id>
            <username>${NEXUS_USER}</username>
            <password>${NEXUS_PASSWORD}</password>
            </server>
        </servers>
        </settings>
        EOF
                            mvn -B -s settings-ci.xml deploy -DskipTests \
                            -DaltDeploymentRepository=nexus-releases::default::${NEXUS_MAVEN_REPO}
                            rm -f settings-ci.xml
                        '''
                    }

                    // 2) Imágenes Docker en docker-hosted
                    sh '''
                        echo "$NEXUS_PASSWORD" | docker login ${NEXUS_REGISTRY} -u "$NEXUS_USER" --password-stdin
                        docker push ${NEXUS_REGISTRY}/studytrack-api:${IMAGE_TAG}
                        docker push ${NEXUS_REGISTRY}/studytrack-frontend:${IMAGE_TAG}
                        docker logout ${NEXUS_REGISTRY}
                    '''
                }
            }
        }

        stage('Deploy & Smoke Test') {
            steps {
                // 1. Despliegue usando la imagen con el tag del build
                sh '''
                    IMAGE_TAG="${IMAGE_TAG}" docker compose -f deploy/docker-compose.yml up -d --build
                '''

                // 2. Smoke Test con reintentos para validar /api/tasks
                sh '''
                    echo "Iniciando validación de disponibilidad en /api/tasks..."
                    
                    MAX_ATTEMPTS=12
                    WAIT_SECONDS=5
                    ATTEMPT=1
                    SUCCESS=false

                    while [ $ATTEMPT -le $MAX_ATTEMPTS ]; do
                        echo "Intento $ATTEMPT de $MAX_ATTEMPTS: haciendo curl a /api/tasks..."
                        
                        # Ajusta el puerto/host si tu servicio escucha en otro puerto (ej: http://localhost:8080/api/tasks)
                        HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8080/api/tasks || true)

                        if [ "$HTTP_STATUS" -eq 200 ]; then
                            echo "✅ Smoke test exitoso! /api/tasks respondió con HTTP 200 OK."
                            SUCCESS=true
                            break
                        else
                            echo "⚠️ El servicio aún no responde OK (Status HTTP: $HTTP_STATUS). Esperando ${WAIT_SECONDS}s..."
                            sleep $WAIT_SECONDS
                            ATTEMPT=$((ATTEMPT + 1))
                        fi
                    done

                    if [ "$SUCCESS" = false ]; then
                        echo "❌ ERROR: Smoke test falló tras $MAX_ATTEMPTS intentos."
                        echo "Mostrando logs del contenedor para depuración:"
                        docker compose -f deploy/docker-compose.yml logs --tail 50
                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline finalizado en verde. Artefactos publicados con tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo "El pipeline falló. Revise los logs de la etapa correspondiente antes de reintentar."
        }
    }
}
